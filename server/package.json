{
  "name": "nessie-agent",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "nessie-agent": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "serve": "bun run src/index.ts serve",
    "chat": "bun run src/index.ts chat",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:e2e": "playwright test tests/e2e --project=firefox",
    "test:e2e:ui": "playwright test tests/e2e --ui --project=firefox",
    "test:e2e:debug": "playwright test tests/e2e --debug --project=firefox",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "bun build src/index.ts --outdir dist --target=node --minify",
    "tts:demo:local": "bun run src/cli/local-voice-sampler.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@playwright/test": "^1.52.0",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@clack/prompts": "^1.0.1",
    "@dotenvx/dotenvx": "latest",
    "ai": "latest",
    "elevenlabs": "^1.59.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  }
}
